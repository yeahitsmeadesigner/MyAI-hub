# GEMINI_API_KEY: Optional server-side API key for Cloud AI Mode.
# AI Studio automatically injects this at runtime from user secrets.
# Never expose this key in client-side code or browser storage.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# RATE_LIMIT_MAX_PER_MINUTE: Max cloud AI requests per minute per client IP
RATE_LIMIT_MAX_PER_MINUTE="30"
